/**
 * Generates supabase/seed.sql from src/data/products.ts so the database
 * starts with the same catalogue as the site.  npm run db:seed-file
 * Prices stay NULL: set real prices in the admin dashboard.
 */
import { writeFileSync } from "node:fs";
import path from "node:path";
import { categories, products } from "../src/data/products.ts";

const q = (v: unknown) =>
  v === null || v === undefined ? "null" : `'${String(v).replace(/'/g, "''")}'`;
const arr = (a: string[]) => (a.length ? `array[${a.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;

const lines: string[] = [
  "-- Generated by scripts/generate-seed.mts. Re-run instead of editing by hand.",
  "-- Prices are starting prices from src/data/products.ts; NULL means \"Price coming soon\".",
  "begin;",
];

categories.forEach((c, i) =>
  lines.push(
    `insert into public.categories (id, name, description, sort_order) values (${q(c.id)}, ${q(c.name)}, ${q(c.description)}, ${i}) on conflict (id) do update set name = excluded.name, description = excluded.description;`,
  ),
);

products.forEach((p, i) => {
  lines.push(
    `insert into public.products (id, slug, name, category_id, short_description, full_description, images, tags, featured, enabled_for_sale, sort_order) values (${q(p.id)}, ${q(p.slug)}, ${q(p.name)}, ${q(p.category)}, ${q(p.shortDescription)}, ${arr(p.fullDescription)}, ${json(p.images)}, ${arr(p.tags)}, ${p.featured}, ${p.enabledForSale}, ${i}) on conflict (id) do nothing;`,
  );
  p.variants.forEach((v, j) =>
    lines.push(
      `insert into public.product_variants (id, product_id, sku, label, size, price_cents, currency, stock_status, stock_quantity, sort_order) values (${q(v.id)}, ${q(p.id)}, ${q(v.sku)}, ${q(v.label)}, ${q(v.size)}, ${v.price ?? "null"}, ${q(p.currency)}, ${q(v.stockStatus)}, null, ${j}) on conflict (id) do nothing;`,
    ),
  );
});

lines.push("commit;", "");
const out = path.resolve(import.meta.dirname, "../supabase/seed.sql");
writeFileSync(out, lines.join("\n"));
console.log(`Wrote ${out} (${products.length} products)`);
